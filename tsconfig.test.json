{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    // Las pruebas también importan código del cliente (mallado, texturas, audio, interfaz): hacen falta los tipos del navegador
    // y los de Vite (los `import '*.css'`).
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["src/shared", "tests"]
}
